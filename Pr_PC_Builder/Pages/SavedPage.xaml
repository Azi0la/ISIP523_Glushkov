<Page x:Class="Pr_PC_Builder.Pages.SavedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_PC_Builder.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SavedPage"
      Background="Salmon">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="313*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
            <Label Margin="0, 15, 0, 0" Content="Сохраненные сборки: " FontSize="25"/>
            <ListBox x:Name="SavedList" Height="300" Margin="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="SavedList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding name}"/>
                            <TextBlock Text="{Binding author}"/>
                            <TextBlock Text="{Binding FullPrice}"/>
                            <ListBox ItemsSource="{Binding partassembly_}" x:Name="SavedItemList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!--Листбокс в листбоксе, это Окси-->
                                            <TextBlock Text="{Binding basepart_.name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <Button x:Name="BackBTN" Width="100" Height="60" VerticalAlignment="Top" Margin="30,365,30,0" Content="Назад" FontSize="25" Click="BackBTN_Click"/>
    </Grid>
</Page>
