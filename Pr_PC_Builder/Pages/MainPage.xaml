<Page x:Class="Pr_PC_Builder.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr_PC_Builder.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="Salmon">

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        

        <ListBox x:Name="UnitList" Grid.Column="0" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" >
                        <Image Source="{Binding image}" Width="70"></Image>
                        <StackPanel>
                            <TextBlock Text="{Binding preview}" Margin="15, 0, 15, 0"></TextBlock>
                        </StackPanel>
                        <Button x:Name="Butt1" Height="50" Width="80" Margin="0, 0, 0, 0" Content="Выбрать" Click="Change_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1">
            <Label x:Name="CompatLabel" Grid.Column="1" Content="Состояние сборки:" FontSize="20"/>
            <TextBox x:Name="CompatTB" Text="" Height="100" Margin="10"/>
            <Label x:Name="NameLabel" Grid.Column="1" Content="Название сборки:" FontSize="15" Margin="0, 5,0,0"/>
            <TextBox x:Name="NameTB" Text="" Height="30" Margin="10, 5, 10, 10"/>
            <Label x:Name="AuthorLabel" Grid.Column="1" Content="Автор сборки:" FontSize="15" Margin="0,0,0,0"/>
            <TextBox x:Name="AuthorTB" Text="" Height="30" Margin="10, 5, 10, 10"/>
            <StackPanel Orientation="Horizontal">
                <Label x:Name="PriceLabel" Grid.Column="1" Content="Цена:" FontSize="15" Margin="0, 0,0,0"/>
                <Label x:Name="RealPriceLabel" Grid.Column="1" Content="" FontSize="15" Margin="0, 0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Button x:Name="SavedBTN" Grid.Column="1" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Content="К сохраненным &#x0a;      сборкам" Click="SavedBTN_Click"/>
        <Button x:Name="CompatBTN" Grid.Column="1" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Content="Сохранить &#x0a;   сборку" IsEnabled="False" Click="CompatBTN_Click"/>


    </Grid>
</Page>
